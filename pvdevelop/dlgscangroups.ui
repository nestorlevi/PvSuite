<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DlgScanGroups</class>
 <widget class="QDialog" name="DlgScanGroups">
  <property name="geometry"><rect><x>0</x><y>0</y><width>720</width><height>460</height></rect></property>
  <property name="windowTitle"><string>pvdevelop: grupos de lectura</string></property>
  <layout class="QVBoxLayout" name="layoutMain">
   <item><widget class="QLabel" name="labelInfo"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>Un grupo de lectura junta variables que se leen con el mismo ciclo (scan_group name=... ms=...). Elegir un grupo y marcar sus variables; las que no están en ningún grupo se leen con su Scan (ms) de la tabla.</string></property></widget></item>
   <item>
    <layout class="QHBoxLayout" name="layoutLists">
     <item>
      <layout class="QVBoxLayout" name="layoutGroups">
       <item><widget class="QLabel" name="labelGroups"><property name="text"><string>Grupos:</string></property></widget></item>
       <item>
        <widget class="QTableWidget" name="tableGroups">
         <property name="toolTip"><string>Nombre del grupo (letras, números y _) y su ciclo en ms (0 = en cada vuelta). Doble clic para cambiarlos; al renombrar, sus variables siguen en el grupo</string></property>
         <property name="selectionMode"><enum>QAbstractItemView::SingleSelection</enum></property>
         <property name="selectionBehavior"><enum>QAbstractItemView::SelectRows</enum></property>
         <attribute name="horizontalHeaderStretchLastSection"><bool>true</bool></attribute>
         <attribute name="verticalHeaderVisible"><bool>false</bool></attribute>
         <column><property name="text"><string>Grupo</string></property></column>
         <column><property name="text"><string>Ciclo (ms)</string></property></column>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="layoutGroupButtons">
         <item><widget class="QPushButton" name="buttonAdd"><property name="toolTip"><string>Agrega un grupo nuevo (después se le cambia el nombre y el ciclo en la tabla)</string></property><property name="text"><string>Agregar</string></property></widget></item>
         <item><widget class="QPushButton" name="buttonRemove"><property name="toolTip"><string>Quita el grupo elegido: sus variables se siguen leyendo con el ciclo que tenía el grupo</string></property><property name="text"><string>Quitar</string></property></widget></item>
         <item><spacer name="spacerGroupButtons"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer></item>
        </layout>
       </item>
      </layout>
     </item>
     <item>
      <layout class="QVBoxLayout" name="layoutTags">
       <item><widget class="QLabel" name="labelTags"><property name="text"><string>Variables del grupo elegido (marcadas):</string></property></widget></item>
       <item><widget class="QListWidget" name="listTags"><property name="toolTip"><string>Marcada: la variable se lee con el grupo elegido (scan=grupo). Desmarcarla la deja con el ciclo del grupo en ms. Entre paréntesis, cómo se lee ahora</string></property></widget></item>
      </layout>
     </item>
    </layout>
   </item>
   <item><widget class="QDialogButtonBox" name="buttonBox"><property name="toolTip"><string>Aceptar pasa los grupos y el ciclo de cada variable al editor de tags (se guardan con Aceptar del editor)</string></property><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget></item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection><sender>buttonBox</sender><signal>accepted()</signal><receiver>DlgScanGroups</receiver><slot>accept()</slot></connection>
  <connection><sender>buttonBox</sender><signal>rejected()</signal><receiver>DlgScanGroups</receiver><slot>reject()</slot></connection>
 </connections>
</ui>
