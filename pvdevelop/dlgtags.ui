            </property>
           </widget>
          </item>
          <item row="0" column="5">
           <widget class="QComboBox" name="comboBitWrite">
            <property name="toolTip">
             <string>Cómo se escribe un bit de un holding register (p. ej. 40300.15).
Leer-modificar-escribir: el daemon lee el registro, cambia el bit y lo escribe (sirve con cualquier PLC).
Función 22: el PLC cambia el bit (Mask Write Register); no todos los PLC la tienen.</string>
            </property>
            <item>
             <property name="text">
              <string>Leer-modificar-escribir</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>Función 22 (Mask Write)</string>
             </property>
            </item>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="labelGap">
            <property name="text">
