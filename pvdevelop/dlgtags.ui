            </property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="spinGap">
            <property name="toolTip">
             <string>Registros (bytes en S7) libres entre dos variables que se leen igual para unirlas en un solo pedido.
auto: 8 registros, 64 coils o 16 bytes.</string>
            </property>
            <property name="specialValueText">
             <string>auto</string>
            </property>
            <property name="minimum">
