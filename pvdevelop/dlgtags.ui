            </property>
           </widget>
          </item>
          <item row="0" column="3">
           <widget class="QComboBox" name="comboOrder">
            <property name="toolTip">
             <string>Orden de las palabras de los valores de 32 bits (dint, udint, real) que manda el PLC.
Cada variable puede cambiarlo en la columna Orden.</string>
            </property>
            <item>
             <property name="text">
              <string>ABCD (big endian)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>CDAB (palabras invertidas)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>BADC (bytes invertidos)</string>
             </property>
            </item>
            <item>
             <property name="text">
              <string>DCBA (little endian)</string>
             </property>
            </item>
           </widget>
          </item>
