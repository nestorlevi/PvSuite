<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DlgNewTag</class>
 <widget class="QDialog" name="DlgNewTag">
  <property name="geometry"><rect><x>0</x><y>0</y><width>460</width><height>250</height></rect></property>
  <property name="windowTitle"><string>pvdevelop: crear un tag</string></property>
  <layout class="QVBoxLayout" name="layoutMain">
   <item><widget class="QLabel" name="labelInfo"><property name="wordWrap"><bool>true</bool></property><property name="text"><string>No hay ningún tag en esa dirección. Se agrega al daemon elegido y se generan de nuevo su .tagmap y su .h (el daemon se compila con Compilar todo, Ctrl+Shift+B).</string></property></widget></item>
   <item>
    <layout class="QFormLayout" name="layoutForm">
     <item row="0" column="0"><widget class="QLabel" name="labelAddress"><property name="text"><string>Dirección:</string></property></widget></item>
     <item row="0" column="1"><widget class="QLineEdit" name="editAddress"><property name="toolTip"><string>La dirección que se escribió (%MW1, 40002, HR1, DB1.DBW0...): se puede corregir</string></property></widget></item>
     <item row="1" column="0"><widget class="QLabel" name="labelDaemon"><property name="text"><string>Daemon:</string></property></widget></item>
     <item row="1" column="1"><widget class="QComboBox" name="comboDaemon"><property name="toolTip"><string>Archivo del daemon (.mkmodbus, .mksiemens) donde se agrega el tag; solo los que entienden esa dirección</string></property></widget></item>
     <item row="2" column="0"><widget class="QLabel" name="labelName"><property name="text"><string>Nombre:</string></property></widget></item>
     <item row="2" column="1"><widget class="QLineEdit" name="editName"><property name="toolTip"><string>Nombre del tag: letras, números y _ (no empieza con un número); no puede repetirse en el daemon</string></property></widget></item>
     <item row="3" column="0"><widget class="QLabel" name="labelType"><property name="text"><string>Tipo:</string></property></widget></item>
     <item row="3" column="1"><widget class="QComboBox" name="comboType"><property name="toolTip"><string>(auto): según la dirección (bit -&gt; bool, registro -&gt; int, %MD -&gt; dint, %MF -&gt; real)</string></property></widget></item>
     <item row="4" column="1"><widget class="QCheckBox" name="checkRw"><property name="toolTip"><string>Marcado: el pvserver y la automatización pueden escribirlo; si no, solo se lee</string></property><property name="text"><string>Lectura y escritura</string></property></widget></item>
     <item row="5" column="0"><widget class="QLabel" name="labelDesc"><property name="text"><string>Comentario:</string></property></widget></item>
     <item row="5" column="1"><widget class="QLineEdit" name="editDesc"><property name="toolTip"><string>Descripción del tag (opcional): se ve al pasar el mouse por el tag en el editor y en los diálogos</string></property></widget></item>
    </layout>
   </item>
   <item><widget class="QDialogButtonBox" name="buttonBox"><property name="toolTip"><string>Aceptar agrega el tag y lo pone en el campo; Cancelar no cambia nada</string></property><property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property></widget></item>
  </layout>
 </widget>
