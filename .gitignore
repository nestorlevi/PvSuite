####################
# git ignore files #
####################
# Nestor: Compilar/ (scripts propios e instalador) no va al repo publico; se compila con pvsuite.pro
/Compilar/
/build/
/msvc/qwt-msvc/lib/

# Nestor: documentacion generada (doc/generar_documentacion) y manuales: no hacen falta para compilar
/doc/pvdevelop/
/doc/pvslib/
/doc/rllib/
/doc/doxygen/gen.log
# Nestor: el texto del manual (HTML) y las herramientas (doc/herramientas) van en git; los PDF y la ayuda integrada se generan
/doc/manual/*.pdf
/doc/ayuda/

# ignore object files
*.o
*.a
*.so
*.so.1
*.so.1.0
*.so.1.0.0
*.obj
*.OBJ
*.dll
*.DLL
*.lib
*.LIB
.qmake.stash
moc_*.h
.~lock.*.odt#



# ignore win-ming/bin
win-mingw/bin/*

# ignore backup files
*~

# ignore Makefile because it will always change due to qmake
Makefile*
pvserver/pvsid.mak
pvserver/pvsmt.mak

# ignore file generated by moc, uic and qrc
moc_*.cpp
ui_*.h
qrc_*.cpp

# ignore executeables
pvbrowser/pvbrowser
pvdevelop/pvdevelop
pvserver/libpvsid.so.1.0.0
pvserver/libpvsmt.so.1.0.0
pvserver/processviewserver
rllib/foreign
rllib/lib/librllib.so.1.0.0
rllib/rlhistory/rlhistory
rllib/rlsvg/rlsvgcat
start_pvbapp/start_pvbapp
win-mingw/bin/start_pvbapp.exe
win-mingw/bin/SetupRegistry.exe
win-mingw/bin/pvbrowser.exe
win-mingw/bin/pvdevelop.exe
win-mingw/bin/rlhistory.exe
win-mingw/bin/fake_qmake.exe
win-mingw/bin/rlsvgcat.exe
language_bindings/lua/pvslua/pvslua
language_bindings/lua/pvslua/pvapplua
# Nestor: advertencias de doxygen (doc/generar_documentacion)
doc/doxygen/doxygen_warnings.txt
# Nestor: los scripts de win-mingw/bin si van en git (lo demas es compilado)
!win-mingw/bin/*.bat
# metadatos de tar (pvb6.tar.gz)
PaxHeaders/
# Nestor: pvlauncher compilado en Linux / macOS
pvlauncher/pvlauncher
pvlauncher/pvlauncher.app/

# Nestor: lo que no va al repo publico (se genera al compilar o es del pvbrowser viejo)
.directory
*.exe
*.EXE
*.so.*
*.dylib
*.mak
*.qm
*.pyc
__pycache__/
*.log
*.pro.user*
*.orig*
murx*
*.murx
.qt/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
cmake-builddir*/
