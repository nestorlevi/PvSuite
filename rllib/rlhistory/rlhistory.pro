        LIBS += $${PWD}/../lib/librllib.a
    }
    else {
        LIBS += $${PWD}/../lib/librllib.so -lpthread
    }
}
#macx::LIBS    += ../lib/librllib.dylib
macx:LIBS     += -L$${PWD}/../lib -lrllib   # Nestor: en macOS rllib es librllib.dylib

