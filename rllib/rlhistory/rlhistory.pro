TEMPLATE = app
CONFIG  += warn_on release console 
CONFIG  -= qt
QWT_ROOT = $${PWD}/..

#mac2017 QMAKE_LFLAGS += -static-libgcc
contains(QMAKE_CXX, g++) {
  !symbian:QMAKE_LFLAGS += -static-libgcc
}
INCLUDEPATH += ../lib

# Input
